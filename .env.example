# Copia este archivo como .env y completa tus claves. Nunca subas el .env a git.
OPENAI_API_KEY=your-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Opcionales (estos son los valores por defecto)
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# none = el modelo no "piensa" antes de responder (más barato). Déjalo vacío si tu modelo no lo acepta.
OPENAI_REASONING_EFFORT=none
RAG_K=4
